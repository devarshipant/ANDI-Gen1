{
  "manifest_version": 3,
  "name": "ANDI-Gen1 \u2014 Accessible Name & Description Inspector",
  "version": "31.3.0",
  "description": "TypeScript rewrite of SSA ANDI with DOM Node Navigation, Semantic Role Detection, Element Inventory Drawer, Notes & Screenshots.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Launch ANDI-Gen1",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}